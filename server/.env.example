# ─── PostgreSQL (docker-compose) ───────────────────────────
# 這三個值同時餵給 compose 建立容器，以及下方的 DATABASE_URL
POSTGRES_USER=easyfigma
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=easyfigma_dev
# 本機映射埠號，若 5432 已被佔用可改成 5433（DATABASE_URL 要跟著改）
POSTGRES_PORT=5432

# ─── Application ───────────────────────────────────────────
# 注意：使用 asyncpg driver，前綴必須是 postgresql+asyncpg
# 部署到 Render 時，將此值換成平台提供的連線字串（需手動把
# postgres:// 改寫為 postgresql+asyncpg://）

# 127.0.0.1 解決 Windows 上 localhost 優先解析成 IPv6 ::1,而 asyncpg 連過去失敗的問題
DATABASE_URL=postgresql+asyncpg://easyfigma:change_me_locally@127.0.0.1:5432/easyfigma_dev

# JSON 陣列格式。前端 dev server 與已部署的前端網域
CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development