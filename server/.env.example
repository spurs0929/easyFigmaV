# ─── PostgreSQL (docker-compose，本機開發用) ───────────────
# 這三個值同時餵給 compose 建立容器，以及下方的 DATABASE_URL
POSTGRES_USER=easyfigma
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=easyfigma_dev
# 本機映射埠號，若 5432 已被佔用可改成 5433（DATABASE_URL 要跟著改）
POSTGRES_PORT=5432

# ─── Database ──────────────────────────────────────────────
# scheme 會由 config.py 自動正規化成 postgresql+asyncpg://，
# 直接貼平台給的原始連線字串即可，sslmode 之類的 libpq 參數會被翻譯成
# asyncpg 的 connect_args，不會被丟掉。
#
# 127.0.0.1 而非 localhost：Windows 上 localhost 會優先解析成 IPv6 ::1，asyncpg 連不上
DATABASE_URL=postgresql+asyncpg://easyfigma:change_me_locally@127.0.0.1:5432/easyfigma_dev

# 留空即可，config.py 會依 host 判斷：本機 → disable，遠端 → verify-full。
# 只有在遠端 TLS 握手失敗時才需要手動降級，例如：
#   - Render 的「internal」連線字串（dpg-xxxx-a，無網域）不走 TLS → disable
#   - 供應商用自簽憑證 → require
# 可用值：disable / allow / prefer / require / verify-ca / verify-full
# DB_SSLMODE=

# Neon 冷啟動（scale to zero 後被喚醒）可能要數秒
DB_CONNECT_TIMEOUT=15

# ─── Application ───────────────────────────────────────────
# JSON 陣列格式（含中括號與雙引號），部署時填已上線的前端網域
CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development
