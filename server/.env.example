# ─── PostgreSQL (docker-compose，本機開發用) ───────────────
POSTGRES_USER=easyfigma
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=easyfigma_dev
POSTGRES_PORT=5432

# ─── Database ──────────────────────────────────────────────
# scheme 會由 config.py 自動正規化成 postgresql+asyncpg://，直接貼平台給的
# 原始連線字串即可；sslmode 之類的 libpq 參數會被翻譯成 asyncpg 的
# connect_args，不會被丟掉。
#
# 127.0.0.1 而非 localhost：Windows 上 localhost 會優先解析成 IPv6 ::1，asyncpg 連不上
DATABASE_URL=postgresql+asyncpg://easyfigma:change_me_locally@127.0.0.1:5432/easyfigma_dev

# 留空即可，config.py 會依 host 判斷：本機 → disable，遠端 → verify-full。
# 只有在遠端 TLS 握手失敗時才需要手動降級，例如 Render 的 internal 連線字串
# （dpg-xxxx-a，無網域）不走 TLS → disable
# 可用值：disable / allow / prefer / require / verify-ca / verify-full
# DB_SSLMODE=

# Neon 冷啟動（scale to zero 後被喚醒）可能要數秒
DB_CONNECT_TIMEOUT=15

# ─── Application ───────────────────────────────────────────
# JSON 陣列格式（含中括號與雙引號），部署時填已上線的前端網域
CORS_ORIGINS=["http://localhost:5173"]

# 只接受 development / test / production。打錯字會直接啟動失敗，
# 不會靜默降級成 development 把安全檢查一起繞過。
ENVIRONMENT=development

# ─── 認證 ──────────────────────────────────────────────────
# 兩把都必須由 CSPRNG 產生，各自至少 32 random bytes，且不可相同：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 兩把分開是為了能各自獨立輪換：
#   SECRET_KEY           簽 JWT。換掉只讓現有 access token 失效（最多 15 分鐘）
#   REFRESH_TOKEN_PEPPER HMAC refresh token。換掉會讓所有人重新登入
#
# ENVIRONMENT=production 時，過短、字元變化過少、或仍是佔位值的 key 會被拒絕啟動。
SECRET_KEY=
REFRESH_TOKEN_PEPPER=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# family 的絕對壽命上限，不會因為持續輪替而延長
REFRESH_FAMILY_MAX_DAYS=30
# 已輪替的 token 在這幾秒內再次出現視為多分頁競態，回可重試的 409 而非撤銷 family
REFRESH_REUSE_GRACE_SECONDS=10

# 同時進行的 argon2 運算上限。19MB × N，小 instance 上並行會超線性惡化
PASSWORD_HASH_CONCURRENCY=2

# 登入 / 註冊 / refresh 的速率限制（單機記憶體實作，多實例需改 Redis）
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
